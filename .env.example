# MaxxLoop Environment Configuration

# App
APP_ENV=development
PORT=8000
DEBUG=true

# Database (default is SQLite local-first)
DATABASE_URL=sqlite:///./maxxloop.db

# LLM Provider: template | gemini | ollama | openai
LLM_PROVIDER=template

# Gemini (optional)
GEMINI_API_KEY=

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI-Compatible (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Demo Mode Settings
DEMO_MODE=true
TIMEWARP_SECONDS=20
STANDARD_WINDOW_MINUTES=25
