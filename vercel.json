{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "nextjs",
            "installCommand": "npm ci",
            "buildCommand": "npm run build"
        },
        "api": {
            "root": "apps/api",
            "framework": "fastapi",
            "entrypoint": "app.main:app",
            "routes": [
                {
                    "src": "/api/(.*)",
                    "transforms": [
                        {
                            "type": "request.path",
                            "op": "set",
                            "args": "/$1"
                        }
                    ]
                }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}